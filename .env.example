# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Deploy (all optional; default to the broadcasting address / 250 bps) ---
OWNER=
FEE_RECIPIENT=
FEE_BPS=250

# --- Full-job script ---
ESCROW_ADDRESS=
# Default to anvil dev accounts #1 / #2 when left empty
CLIENT=
PROVIDER=
JOB_AMOUNT=100000000000000000

# --- Arbitrum Sepolia (optional) ---
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBISCAN_API_KEY=your-arbiscan-api-key-here
# Prefer an encrypted keystore over a raw key:  cast wallet import throwaway --interactive
